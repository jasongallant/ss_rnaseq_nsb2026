# Workshop infrastructure environment variables.
#
# Usage: copy this file to bts/infrastructure/.env and fill in the values
# below. Load into your shell at the start of any work session:
#
#   set -a; source bts/infrastructure/.env; set +a
#
# (The `set -a` / `set +a` toggle exports every variable assigned while it's
# active, so this file can stay plain KEY=VALUE without `export` lines.)
#
# The real .env file is git-ignored — it contains your GitHub PAT and AWS
# resource IDs that don't belong in the public repo.

# ----- One-time, set before Phase 0 --------------------------------------

REGION=us-east-1

# SSH key — set KEY_NAME to whatever you named it in AWS, KEY_FILE to its
# local PEM path.
KEY_NAME=
KEY_FILE=

# Workshop identity — propagated into cloud-init at launch.
WORKSHOP_DOMAIN=
ADMIN_EMAIL=

# S3 bucket holding content/ (workbooks) and data/ (bulk data). Must be
# globally unique.
WORKSHOP_BUCKET=

# IAM instance profile created in Phase 0.4. The workshop instance assumes
# this role so it can read content/ from S3 at boot.
INSTANCE_PROFILE=

# ----- AMI build inputs (Phase 1) ----------------------------------------

# Ubuntu 24.04 LTS in us-east-1. For incremental rebuilds, replace with
# last year's AMI_ID so apt/rig/renv skip already-done work.
BASE_AMI=ami-0fbcf351e82d18381

# HTTPS URL to renv.lock. Standard form is the raw.githubusercontent.com
# URL for the main branch.
RENV_LOCK_URL=https://raw.githubusercontent.com/jasongallant/ss_rnaseq_nsb2026/main/renv.lock

# Zero-scope GitHub PAT — lifts the API rate limit so renv can resolve
# GitHub-sourced packages like presto without throttling. Generate at
# https://github.com/settings/tokens (classic, no scopes selected).
# SECRET — keep this in .env, never commit.
GITHUB_PAT=ghp_REPLACE_ME

# ----- Launch parameters (Phase 3) ---------------------------------------

# Block device name the data EBS volume will appear at on the workshop
# instance. On r6i (Nitro) this is /dev/nvme1n1 when attached as /dev/sdf.
# Run `lsblk` on the running instance if uncertain.
DATA_DEVICE=/dev/nvme1n1

# ----- Captured outputs (fill in as you complete each phase) -------------
#
# After capturing an output ID in your shell, edit this file to set the
# corresponding line so re-opening your terminal recovers state.
#
# Quick one-liner to update a value in place:
#   sed -i.bak "s|^SG_ID=.*|SG_ID=$SG_ID|" bts/infrastructure/.env

# Phase 0.2 — security group
SG_ID=

# Phase 0.2 — your home/office IP (will rotate; re-set when it changes)
VPC_ID=
MY_IP=

# Phase 1.5 — golden AMI
AMI_ID=

# Phase 2.3 — data volume snapshot
DATA_SNAPSHOT_ID=

# Phase 3.1 — Elastic IP
EIP_ALLOC_ID=
EIP_PUBLIC_IP=

# Phase 3.3 — workshop instance
INSTANCE_ID=
